{
  "name": "cc-motion-editor",
  "productName": "CC Motion Editor",
  "version": "0.2.0",
  "description": "CC Motion Editor — dựng motion graphic bằng Claude và edit video trên macOS. Phát triển bởi Chợ Chời Creative Studio.",
  "main": "out/main/index.js",
  "author": {
    "name": "Chợ Chời Creative Studio"
  },
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "dist:mac": "electron-vite build && electron-builder --mac --config electron-builder.yml",
    "test:e2e": "electron-vite build && node tests/e2e/smoke.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "playwright-core": "^1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "zustand": "^5.0.15"
  }
}
